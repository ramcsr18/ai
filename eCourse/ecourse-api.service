[Unit]
Description=eCourse FastAPI Backend
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/html/ecourse
Environment="OLLAMA_BASE_URL=http://localhost:11434"
ExecStart=/var/www/html/ecourse/venv/bin/uvicorn api:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
