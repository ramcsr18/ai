server {
    listen 80;
    server_name _; # Replace with your domain or IP

    # Root location / is already taken by another service.
    # eCourse is hosted under the /ecourse/ context.

    # 1. Streamlit Frontend
    # Note: Streamlit must be started with --server.baseUrlPath /ecourse
    location /ecourse/ {
        proxy_pass http://localhost:8501;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # 2. FastAPI Backend
    location /ecourse/api/ {
        proxy_pass http://localhost:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
