# Local development defaults
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/evote
JWT_SECRET=replace-with-a-long-random-secret
PRIVATE_KEY=replace-with-a-development-private-key

GOVERNMENT_VERIFICATION_API_URL=https://government.example.gov/v1/voters/verify
GOVERNMENT_VERIFICATION_API_KEY=replace-with-provider-api-key
GOVERNMENT_VERIFICATION_TIMEOUT_MS=5000

BIOMETRIC_VERIFICATION_API_URL=https://biometric.example.gov/v1/verify
BIOMETRIC_VERIFICATION_API_KEY=replace-with-biometric-provider-key
BIOMETRIC_VERIFICATION_TIMEOUT_MS=5000
BIOMETRIC_VERIFICATION_REQUIRED=true

# Use true to force all external verification calls to return success during local testing
USE_TEST_VERIFICATION_API=true

# Production-scale settings for high-throughput environments
# See .env.scalable.example for the full multi-service architecture template
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
WORKER_CONCURRENCY=4
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300