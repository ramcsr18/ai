# Production-scale environment template for eVote
NODE_ENV=production
PORT=5001
API_BASE_URL=http://localhost:5001

# Core database
MONGODB_URI=mongodb://mongo-primary:27017,mongo-secondary:27017/evote?replicaSet=evote-rs&readPreference=secondaryPreferred
MONGODB_WRITE_CONCERN=w1
MONGODB_MAX_POOL_SIZE=100

# Cache and session layer
REDIS_URL=redis://redis-primary:6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_TLS=false
REDIS_CACHE_TTL_SECONDS=300
REDIS_SESSION_TTL_SECONDS=1800

# Queue / event bus
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
VERIFICATION_TOPIC=voter-verification.requests
VERIFICATION_RESULT_TOPIC=voter-verification.results
VOTE_TOPIC=vote.submission.requests
VOTE_RESULT_TOPIC=vote.submission.results
AUDIT_TOPIC=audit.events
KAFKA_CLIENT_ID=evote-backend

# Authentication and signing
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
PRIVATE_KEY=replace-with-a-production-private-key

# Government API and biometric APIs
GOVERNMENT_VERIFICATION_API_URL=https://government.example.gov/v1/voters/verify
GOVERNMENT_VERIFICATION_API_KEY=replace-with-provider-api-key
GOVERNMENT_VERIFICATION_TIMEOUT_MS=5000

BIOMETRIC_VERIFICATION_API_URL=https://biometric.example.gov/v1/verify
BIOMETRIC_VERIFICATION_API_KEY=replace-with-biometric-provider-key
BIOMETRIC_VERIFICATION_TIMEOUT_MS=5000
BIOMETRIC_VERIFICATION_REQUIRED=true

# Local / test support
USE_TEST_VERIFICATION_API=false

# Rate limiting and resilience
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
REQUEST_TIMEOUT_MS=15000
RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=250

# Worker tuning
WORKER_CONCURRENCY=8
VERIFICATION_WORKER_CONCURRENCY=4
VOTE_WORKER_CONCURRENCY=4

# Observability
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Security / edge
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
SECURE_COOKIES=true
TRUST_PROXY=true
